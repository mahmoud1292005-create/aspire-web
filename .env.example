PORT=5000

# Supabase: Project Settings -> Database -> Connection string -> URI (Direct connection)
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Set to true if using Supabase (auto-detected from supabase.com in DATABASE_URL)
DB_SSL=true

JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Mailtrap Send API token (Mailtrap dashboard -> Sending Domains / API Tokens).
# Leave blank in development - emails will log to the console instead.
SMTP_PASS=
SMTP_FROM=Aspire <noreply@aspire.local>
